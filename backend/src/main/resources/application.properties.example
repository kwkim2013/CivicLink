# PostgreSQL connection
database.url=jdbc:postgresql://localhost:5432/civiclink
database.username=postgres
database.password=${CIVICLINK_DB_PASSWORD:}

# Set PUBLICDATA_SERVICE_KEY in your environment before starting the server.
publicdata.service-key=${PUBLICDATA_SERVICE_KEY:}
